{
  "name": "lunch-app",
  "version": "0.1.0",
  "private": true,
  "description": "Dagens lunch nära Knowit-kontoret i Göteborg",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "astro build && node server.ts",
    "build": "node scripts/build.ts",
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "26.6.6",
    "astro": "7.4.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "sortablejs": "1.15.7"
  }
}
