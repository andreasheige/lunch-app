{
  "name": "lunch-app",
  "version": "0.1.0",
  "private": true,
  "description": "Dagens lunch nära Knowit-kontoret i Göteborg",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "build": "node scripts/build.ts",
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/node": "24.19.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
