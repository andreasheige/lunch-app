{
  "name": "lunch-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/lunch.json is a build-time snapshot; the Worker serves it live instead.
    "run_worker_first": ["/lunch.json", "/report"]
  },
  // Per-IP cap on POST /report, on top of Turnstile.
  "ratelimits": [
    { "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
