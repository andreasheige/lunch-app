{
  "name": "lunch-app",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/lunch.json is a build-time snapshot; the Worker serves it live instead.
    "run_worker_first": ["/lunch.json", "/report"]
  },
  // Workers AI, for veg/fish/meat guesses on dishes the restaurant doesn't label (see diet.ts).
  "ai": { "binding": "AI" },
  // Deployed version id, used in the /lunch.json cache key.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Per-IP cap on POST /report, on top of Turnstile.
  "ratelimits": [{ "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
