{
  "name": "lunch-app",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/lunch.json is a build-time snapshot; the Worker serves it live instead.
    "run_worker_first": ["/lunch.json", "/report", "/releases.json", "/rate", "/ratings.json", "/stats.json"]
  },
  // Workers AI, for veg/fish/meat guesses on dishes the restaurant doesn't label (see diet.ts).
  "ai": { "binding": "AI" },
  // Release-note texts (and, later, ratings). Schema in migrations/; apply with
  // `npx wrangler d1 migrations apply lunch-app --remote`.
  "d1_databases": [
    { "binding": "DB", "database_name": "lunch-app", "database_id": "ff75d76e-6847-4a47-991d-cc5b928c2d0d" }
  ],
  // Deployed version id, used in the /lunch.json cache key.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Per-IP cap on POST /report, on top of Turnstile.
  "ratelimits": [
    { "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Per-IP cap on POST /rate. The office shares one IP, so it's generous.
    { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
