---
// Site header: the lunchit wordmark, the page tabs (the current one as a filled pill), the light/dark toggle
// (public/theme.js) and the language switch. Texts are Swedish and swapped by i18n.js (data-i18n).
interface Props {
  current: 'lunch' | 'stats' | 'news';
}
const { current } = Astro.props;
const links = [
  { id: 'lunch', href: '/', key: 'nav.lunch', text: 'Lunch' },
  { id: 'stats', href: '/stats', key: 'nav.stats', text: 'Statistik' },
  { id: 'news', href: '/news', key: 'nav.news', text: 'Nyheter' },
];
---
<header class="site-header">
  <nav class="site-nav" aria-label="Sajtnavigering" data-i18n-label="nav.label">
    <a href="/" class="wordmark">lunchit</a>
    {links.map((l) => <a href={l.href} aria-current={l.id === current ? 'page' : undefined} data-i18n={l.key}>{l.text}</a>)}
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Byt till mörkt läge">
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
    </button>
    <button type="button" id="lang-toggle" class="lang-toggle" data-i18n="lang.short" data-i18n-label="lang.switch" aria-label="In English">EN</button>
  </nav>
</header>
