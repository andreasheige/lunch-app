---
import { SITE } from '../snapshot.ts';
// Shared <head> and nav. Each page's own script is plain JS from public/, loaded as is (not bundled).
import Nav from './Nav.astro';

interface Props {
  title: string;
  titleKey: string;
  description: string;
  path: string;
  script: string;
  current: 'lunch' | 'stats' | 'news';
}
const { title, titleKey, description, path, script, current } = Astro.props;
const url = `${SITE}${path}`;
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Lunchit">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={`${SITE}/icon-512.png`}>
  <meta property="og:locale" content="sv_SE">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/json" href="/lunch.json" title="Dagens lunch som JSON">
  <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <meta name="apple-mobile-web-app-title" content="Lunchit">
  <meta name="theme-color" content="#23211e" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f3f3ef" media="(prefers-color-scheme: light)">
  <link rel="stylesheet" href="/style.css">
  <script is:inline src={`/${script}`} type="module"></script>
  <slot name="head" />
</head>
<body data-title={titleKey}>
  <Nav current={current} />
  <slot />
</body>
</html>
