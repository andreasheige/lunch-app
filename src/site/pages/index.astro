---
import Layout from '../components/Layout.astro';
import Place from '../components/Place.astro';
import { jsonForScript, lunchSnapshot, SITE } from '../snapshot.ts';

const lunch = lunchSnapshot();
const places = lunch?.day ? [...lunch.restaurants].sort((a, b) => a.distance - b.distance) : [];
const date = lunch
  ? new Intl.DateTimeFormat('sv-SE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
      new Date(`${lunch.date}T12:00:00Z`),
    )
  : 'Dagens lunch';
const DIET_URL = { veg: 'https://schema.org/VegetarianDiet' };
// schema.org: the site, and each place with today's menu, for search engines and agents.
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Lunchit', url: SITE, inLanguage: ['sv', 'en'] },
    ...places.map((r) => ({
      '@type': 'Restaurant',
      name: r.name,
      url: r.url,
      address: {
        '@type': 'PostalAddress',
        streetAddress: r.address,
        addressLocality: 'Göteborg',
        addressCountry: 'SE',
      },
      ...(r.price && { priceRange: r.price }),
      hasMenu: {
        '@type': 'Menu',
        name: `Dagens lunch ${lunch?.date}`,
        // Names only: the descriptions are in the page itself, and leaving them out keeps the page within the
        // first network round trip (~14 kB gzipped).
        hasMenuItem: r.dishes.map((d) => ({
          '@type': 'MenuItem',
          name: d.name,
          ...(d.diet === 'veg' && { suitableForDiet: DIET_URL.veg }),
        })),
      },
    })),
  ],
};

const diets = [
  { id: 'veg', key: 'diet.veg', text: 'Vegetariskt' },
  { id: 'fish', key: 'diet.fish', text: 'Fisk' },
  { id: 'meat', key: 'diet.meat', text: 'Kött' },
];
const allergens = [
  { id: 'nuts', key: 'allergen.nuts', text: 'Nötter' },
  { id: 'gluten', key: 'allergen.gluten', text: 'Gluten' },
  { id: 'lactose', key: 'allergen.lactose', text: 'Laktos' },
  { id: 'shellfish', key: 'allergen.shellfish', text: 'Skaldjur' },
  { id: 'egg', key: 'allergen.egg', text: 'Ägg' },
];
---
<Layout
  title="Dagens lunch – Lunchit"
  titleKey="title.lunch"
  description="Dagens lunchmenyer från restaurangerna runt Platinan vid Centralen i Göteborg: rätter, priser, öppettider och gångavstånd, med filter för kost och allergener."
  path="/"
  script="app.js"
  current="lunch"
>
<script type="application/ld+json" slot="head" set:html={jsonForScript(ld)} />
<header class="page-head">
  <div class="date-row">
    <h1 id="today">{date}</h1>
    <span id="week" class="week">{lunch && `Vecka ${lunch.week}`}</span>
  </div>
  <p id="lunch-status" class="lunch-status"></p>
  <p id="lunch-soon" class="lunch-soon" hidden></p>
</header>
<div class="page-body">
  <button type="button" id="picker-open" class="decide">
    <span class="decide-text">
      <span class="decide-title" data-i18n="decide.title">Kan du inte bestämma dig?</span>
      <span class="decide-sub" data-i18n="decide.sub">Svara på tre snabba frågor så föreslår vi ett ställe.</span>
    </span>
    <span class="decide-go"><span data-i18n="picker.open">Välj åt mig</span> →</span>
  </button>
  <div class="controls">
    <div class="chip-row" role="group" aria-label="Visa kost" data-i18n-label="diet.legend">
      <button type="button" class="chip diet-chip" data-diet-all aria-pressed="true"><span data-i18n="diet.all">Alla</span> <span class="chip-count" data-count="all"></span></button>
      {diets.map((d) => (
        <button type="button" class="chip diet-chip" data-diet={d.id} aria-pressed="false"><span data-i18n={d.key}>{d.text}</span> <span class="chip-count" data-count={d.id}></span></button>
      ))}
      <button type="button" id="filter-open" class="chip allergen-open" aria-haspopup="dialog"><span data-i18n="allergens">Allergener</span> <span id="filter-count" class="count" hidden></span></button>
    </div>
    <button type="button" id="display-open" class="display-open" popovertarget="display-menu" aria-haspopup="true">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span data-i18n="display.open">Visning</span>
    </button>
    <div id="display-menu" class="display-menu" popover>
      <p class="menu-label" id="view-label" data-i18n="view.label">Visa som</p>
      <div class="views" role="group" aria-labelledby="view-label">
        <button type="button" data-view="cards" aria-pressed="false" data-i18n="view.cards">Kort</button>
        <button type="button" data-view="overview" aria-pressed="false" data-i18n="view.overview">Lista</button>
        <button type="button" data-view="dishes" aria-pressed="false" data-i18n="view.dishes">Rätter</button>
      </div>
      <fieldset class="order-choice">
        <legend class="menu-label" data-i18n="order.label">Ordning</legend>
        <label><input type="radio" name="order" value="nearest"> <span data-i18n="order.nearest-label">Närmast först</span></label>
        <label><input type="radio" name="order" value="mine"> <span data-i18n="order.mine-label">Min ordning</span></label>
        <button type="button" id="sort-toggle" class="order-edit" data-i18n="order.edit">Ändra min ordning…</button>
      </fieldset>
    </div>
  </div>
  <main id="restaurants" aria-live="polite" aria-busy="true">
    {places.length ? (
      <div class="cards">{places.map((r) => <Place r={r} />)}</div>
    ) : lunch && !lunch.day ? (
      <p class="notice" data-i18n="notice.weekend">Det är helg – inga luncher idag. Restaurangerna är tillbaka med nya menyer på måndag.</p>
    ) : (
      <>
        <article class="place skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></article>
        <article class="place skeleton" aria-hidden="true"><span></span><span></span><span></span></article>
        <article class="place skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></article>
      </>
    )}
  </main>
  <details id="yesterday" class="yesterday" hidden></details>
</div>
<footer>
  <p data-i18n="footer.source">Menyerna läses från restaurangernas egna sidor. Fråga alltid personalen om allergier.</p>
  <p id="updated"></p>
  <p class="report">
    <button type="button" data-report="bug" data-i18n="report.bug">Rapportera fel</button>
    · <button type="button" data-report="feat-req" data-i18n="report.feat">Önska funktion</button>
    <span id="install" hidden>· <button type="button" id="install-open" data-i18n="install.open">Lägg till på hemskärmen</button></span>
  </p>
</footer>
<dialog id="filter-dialog" class="sheet" aria-labelledby="filter-heading">
  <div class="sheet-head">
    <h2 id="filter-heading" data-i18n="allergens">Allergener</h2>
    <button type="button" id="filter-close" class="sheet-close" aria-label="Stäng" data-i18n-label="close"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></button>
  </div>
  <section class="filter-panel">
    <fieldset class="allergen-chips">
      <legend data-i18n="allergens.legend">Markera rätter som nämner</legend>
      <div class="chips">
        {allergens.map((a) => (
          <button type="button" class="chip" data-allergen={a.id} aria-pressed="false" data-i18n={a.key}>{a.text}</button>
        ))}
      </div>
      <p class="filter-note" data-i18n="allergens.note">
        Bygger bara på vad menytexten nämner. Omarkerade rätter kan ändå innehålla allergenen – fråga alltid restaurangen.
      </p>
    </fieldset>
    <div class="filter-actions">
      <button type="button" id="filter-clear" class="filter-clear" data-i18n="filter.clear">Rensa</button>
      <button type="button" id="filter-done" class="filter-done"></button>
    </div>
  </section>
</dialog>
<dialog id="picker-dialog" class="sheet" aria-labelledby="picker-heading">
  <div class="sheet-head">
    <p id="picker-step" class="picker-step"></p>
    <button type="button" id="picker-close" class="sheet-close" aria-label="Stäng" data-i18n-label="close"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></button>
  </div>
  <h2 id="picker-heading" class="picker-heading" data-i18n="picker.open">Välj åt mig</h2>
  <div id="picker-body" class="picker-body"></div>
</dialog>
<dialog id="install-dialog" aria-labelledby="install-heading">
  <h2 id="install-heading" data-i18n="install.open">Lägg till på hemskärmen</h2>
  <ol class="install-steps">
    <li data-i18n="install.share">Tryck på Dela-knappen (fyrkanten med en pil uppåt).</li>
    <li data-i18n="install.add">Välj ”Lägg till på hemskärmen”.</li>
    <li data-i18n="install.confirm">Tryck på Lägg till.</li>
  </ol>
  <form method="dialog" class="report-actions"><button type="submit" data-i18n="close">Stäng</button></form>
</dialog>
<dialog id="report-dialog" aria-labelledby="report-heading">
  <form id="report-form" method="dialog" novalidate>
    <h2 id="report-heading" data-i18n="report.bug">Rapportera fel</h2>
    <fieldset class="kind">
      <legend data-i18n="report.kind">Typ</legend>
      <label><input type="radio" name="kind" value="bug" checked> <span data-i18n="report.kind-bug">Fel</span></label>
      <label><input type="radio" name="kind" value="feat-req"> <span data-i18n="report.kind-feat">Önskemål</span></label>
    </fieldset>
    <label><span data-i18n="report.title">Rubrik</span> <input name="title" required maxlength="120" autocomplete="off"></label>
    <label><span data-i18n="report.text">Beskrivning</span> <textarea name="text" required maxlength="4000" rows="5"></textarea></label>
    <details class="notify">
      <summary class="notify-toggle"><span data-i18n="report.notify">Vill du få ett mejl när det är klart?</span> <span class="optional" data-i18n="report.optional">(valfritt)</span></summary>
      <div class="notify-fields">
        <label><span data-i18n="report.name">Namn</span> <input name="name" maxlength="80" autocomplete="name"></label>
        <label><span data-i18n="report.email">E-post</span> <input name="email" type="email" maxlength="254" autocomplete="email"></label>
        <label class="consent"><input type="checkbox" name="notify"> <span data-i18n="report.consent">Mejla mig när ärendet är stängt. Namn och adress visas inte på GitHub och raderas när mejlet har skickats.</span></label>
      </div>
    </details>
    <label class="hp" aria-hidden="true">Webbplats <input name="website" tabindex="-1" autocomplete="off"></label>
    <div id="report-turnstile"></div>
    <p id="report-status" class="report-status" role="status"></p>
    <div class="report-actions">
      <button type="button" value="cancel" id="report-cancel" data-i18n="report.cancel">Avbryt</button>
      <button type="submit" id="report-submit" data-i18n="report.send">Skicka</button>
    </div>
    <p class="report-note" data-i18n="report.public">Rubrik och beskrivning blir ett publikt ärende på GitHub – skriv inga personuppgifter där.</p>
  </form>
</dialog>
</Layout>
