---
import Layout from '../components/Layout.astro';
---
<Layout title="Statistik – Dagens lunch" titleKey="title.stats" script="stats.js" current="stats">
<header class="page-head">
  <h1 data-i18n="stats.title">Statistik</h1>
  <p class="lunch-status" data-i18n="stats.intro">Vad tycker lunchgästerna? Betygsätt dagens rätter med stjärnorna på startsidan.</p>
</header>
<main class="stats">
  <div class="stats-controls">
    <fieldset class="segmented">
      <legend class="visually-hidden" data-i18n="stats.period">Period</legend>
      <button type="button" class="seg" data-range="14" aria-pressed="true" data-i18n="stats.14">Senaste 2 veckorna</button>
      <button type="button" class="seg" data-range="all" aria-pressed="false" data-i18n="stats.all">Hela tiden</button>
    </fieldset>
    <button type="button" id="present" class="present"><span data-i18n="stats.present">Presentera</span></button>
  </div>
  <section id="slide" class="slide" aria-live="polite" aria-busy="true">
    <p class="notice" data-i18n="stats.loading">Hämtar statistik…</p>
  </section>
  <div id="viz-tooltip" class="viz-tooltip" role="tooltip" hidden></div>
</main>
<footer>
  <p data-i18n="stats.footer">Betygen är anonyma: varje webbläsare får ett slumpat id, och en ny röst på samma rätt samma dag ersätter den gamla.</p>
  <p><a class="footer-link" href="/" data-i18n="back">← Tillbaka till dagens lunch</a></p>
</footer>
</Layout>
