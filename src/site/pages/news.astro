---
import Layout from '../components/Layout.astro';
---
<Layout title="Nyheter – Lunchit"
  description="Allt nytt och fixat på Lunchit, sajten med dagens lunchmenyer nära Knowit-kontoret i Göteborg."
  path="/news" titleKey="title.news" script="news.js" current="news">
<header class="page-head">
  <h1 data-i18n="news.title">Nyheter</h1>
  <p class="lunch-status" data-i18n="news.intro">Allt nytt och fixat på lunchsajten – oftast för att någon önskade det.</p>
</header>
<main id="notes" class="blog" aria-live="polite" aria-busy="true">
  <article class="post skeleton" aria-hidden="true"><span></span><span></span><span></span></article>
  <article class="post skeleton" aria-hidden="true"><span></span><span></span><span></span></article>
</main>
<footer>
  <p data-i18n="news.footer">Texterna skrivs om till svenska av AI utifrån ändringarna i koden.</p>
  <p><a class="footer-link" href="/" data-i18n="back">← Tillbaka till dagens lunch</a></p>
</footer>
</Layout>
